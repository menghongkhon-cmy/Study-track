# Copy to /etc/studytrack/studytrack.env and replace every placeholder.
PORT=8000
STUDYTRACK_HOST=127.0.0.1
STUDYTRACK_DB=/var/lib/studytrack/studytrack.sqlite3
STUDYTRACK_SECURE_COOKIE=1
STUDYTRACK_PUBLIC_URL=https://study.example.com
STUDYTRACK_TEACHER_CODE=replace-with-a-long-private-code
STUDYTRACK_ADMIN_CODE=replace-with-a-different-long-private-code
STUDYTRACK_ACCESS_LOG=0

# Optional. Leave blank until each provider's OAuth callback is configured.
STUDYTRACK_GOOGLE_CLIENT_ID=
STUDYTRACK_GOOGLE_CLIENT_SECRET=
STUDYTRACK_GITHUB_CLIENT_ID=
STUDYTRACK_GITHUB_CLIENT_SECRET=
STUDYTRACK_TELEGRAM_CLIENT_ID=
STUDYTRACK_TELEGRAM_CLIENT_SECRET=
