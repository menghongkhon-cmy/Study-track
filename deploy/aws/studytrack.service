[Unit]
Description=StudyTrack web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studytrack
Group=studytrack
WorkingDirectory=/opt/studytrack
EnvironmentFile=/etc/studytrack/studytrack.env
ExecStart=/opt/studytrack/.venv/bin/python /opt/studytrack/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/studytrack
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
